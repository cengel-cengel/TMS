# Raw data directories (PDFs, Excel, ZIP) — too large for git
Fischerwerke/
Herma/

# Large data files anywhere in the repo
**/*.pdf
**/*.PDF
**/*.xlsx
**/*.xls
**/*.xlsb
**/*.xlsm
**/*.zip
**/*.gz

# Keep directory structure
!**/.gitkeep

# Allow audit report outputs
!output/audit_bericht_*.xlsx
!output/herma_gb_konditions_analyse.xlsx
