# Python bytecode
__pycache__/
*.pyc
*.pyo

# Scratch / debug scripts at repo root
debug*.py
run_etappe*.py

# Raw data directories (PDFs, Excel, ZIP) — too large for git
Fischerwerke/
Herma/

# Extracted ZIP contents — too large for git (2+ GB binaries)
data/extracted/

# Large data files anywhere in the repo
**/*.pdf
**/*.PDF
**/*.jpg
**/*.jpeg
**/*.png
**/*.xlsx
**/*.xls
**/*.xlsb
**/*.xlsm
**/*.zip
**/*.gz

# Keep directory structure
!**/.gitkeep

# Allow audit report outputs
!output/erka_lieferung/Sendungs_Gegenueberstellung_v1_0.xlsx
!output/erka_lieferung/*_Vergleich.xlsx
!output/audit_bericht_*.xlsx
!output/herma_gb_konditions_analyse.xlsx
!output/top20_audit_*.xlsx
!output/gb_rechnungsvergleich.xlsx
!output/s5_tariff_check_2026.xlsx
!output/cluster_vergleich_5vs5.xlsx
!output/*/rechnungsvergleich.xlsx
!data/Besonderheiten_bei_der_Kundenabrechnung.xlsx
